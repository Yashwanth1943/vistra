# Application URL (used to construct magic login links)
APP_URL=https://vistra-learn.vercel.app

# MongoDB Atlas connection string (server-side only; never expose to the browser)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Vistra

# MongoDB database name
MONGODB_DB=vistra

# Email mode: 'development' (restricts sending to RESEND_TEST_RECIPIENT) or 'production'
EMAIL_MODE=development

# Single authorized Resend account email used when EMAIL_MODE=development
RESEND_TEST_RECIPIENT=your-resend-account-email@example.com

# Resend API key (server-side only; never expose to the browser)
EMAIL_PROVIDER_API_KEY=<your-resend-api-key>

# Verified sender address for transactional emails
EMAIL_FROM=Vistra <onboarding@resend.dev>

# At least 32-byte random hex/base64 secret for HMAC token & session hashing
SESSION_SECRET=<your-64-char-hex-secret>

# Google OAuth 2.0 / OpenID Connect (server-side only; never expose client secret)
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_REDIRECT_URI=https://vistra-learn.vercel.app/api/auth/google/callback

# Comma-separated allowed registration email domains (defaults to gmail.com)
ALLOWED_EMAIL_DOMAINS=gmail.com
